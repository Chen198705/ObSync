<view class="container">
  <view class="header">
    <text class="title">已保存的文章</text>
    <text class="desc">共 {{articles.length}} 篇文章</text>
  </view>

  <view class="articles-list">
    <block wx:for="{{articles}}" wx:key="id">
      <view class="article-card">
        <text class="article-title">{{item.title}}</text>
        <view class="article-meta">
          <text class="meta-item">{{item.account || '未知公众号'}}</text>
          <text class="meta-sep">·</text>
          <text class="meta-item">{{item.savedAt}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{articles.length === 0}}" class="empty">
      <text class="empty-text">暂无已保存的文章</text>
    </view>
  </view>
</view>
